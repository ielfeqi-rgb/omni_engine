#!/usr/bin/env bash
# Omni Engine CLI Launcher
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LD_LIBRARY_PATH="$SCRIPT_DIR/bin:$LD_LIBRARY_PATH"

if [ -f "$SCRIPT_DIR/target/release/omni_engine" ]; then
    exec "$SCRIPT_DIR/target/release/omni_engine" "$@"
else
    echo "❌ Error: target/release/omni_engine not found. Please build it first."
    exit 1
fi
